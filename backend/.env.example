# ==============================================================
# Sentrion API — environment configuration
# Copy this file to .env and fill in real values for local dev.
# Never commit a real .env file.
# ==============================================================

# --- Application ---
PROJECT_NAME="Sentrion API"
ENVIRONMENT=development
API_PREFIX=/api

# --- Database ---
# PostgreSQL connection string, e.g.:
# postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://sentrion:sentrion@localhost:5432/sentrion

# --- CORS ---
# Comma-separated list of origins allowed to call this API.
# The Vite dev server defaults to http://localhost:5173.
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Security: required before starting or migrating ---
# Generate a real value with: openssl rand -hex 32
SECRET_KEY=
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Back this key up with the database; losing it makes camera secrets unreadable.
CAMERA_ENCRYPTION_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_ALGORITHM=HS256
# --- MediaMTX live streaming ---
# Control API stays localhost-only. The browser URLs can be changed to your LAN/public host later.
MEDIAMTX_API_URL=http://127.0.0.1:9997
MEDIAMTX_WEBRTC_URL=http://127.0.0.1:8889
MEDIAMTX_HLS_URL=http://127.0.0.1:8888

